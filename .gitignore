# raw CCTV data, never committed
/label/
/no_label/
/input/
/output/
/review/
/logs/

# git worktrees
/.worktrees/

# python
__pycache__/
*.pyc
.venv/
venv/

# model weights (trained checkpoints actually used by the app are allowlisted
# below -- everything else, e.g. retrain_yolo.py's archived candidates and
# manual iteration snapshots, stays ignored so the repo doesn't accumulate
# near-duplicate multi-MB blobs)
*.pt
*.onnx
/models/*/weights/
/models/archive/
models/*.joblib
!models/yolov8_seg_slots_production.pt
!models/yolov8_pose_marking_points.pt
!models/slot_classifier.joblib

# ultralytics training run artifacts (logs, plots, checkpoints)
/runs/

# web app runtime data
/web_uploads/
/web/frontend/node_modules/
/web/frontend/dist/

# worktree symlinks to gitignored real-data dirs (trailing-slash patterns above don't match symlinks)
/no_label
/label
/output
/review
/.venv
/origin_no_label
/origin_no_label2
/label2
/datasets
/config
/test1
/test2

# macOS
.DS_Store
